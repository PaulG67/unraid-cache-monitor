<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "cache-monitor">
<!ENTITY author    "PaulG67">
<!ENTITY version   "2026.11.13.2">
<!ENTITY launch    "Settings/CacheMonitor">
<!ENTITY pluginURL "https://raw.githubusercontent.com/PaulG67/unraid-cache-monitor/main/cache-monitor.plg">
<!ENTITY gitURL    "https://raw.githubusercontent.com/PaulG67/unraid-cache-monitor/main/src/usr/local/emhttp/plugins/cache-monitor">
<!ENTITY support   "https://github.com/PaulG67/unraid-cache-monitor">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="&support;" icon="hdd-o" min="6.9.0">

<CHANGES>
### &version;
- Seite unter Einstellungen, Benutzer-Utilities
- Seiteninhalt wird ausgeführt statt als PHP-Text angezeigt

### 2026.11.13
- Belegung, frei und Prozent je Cache-Pool
- Ordner und Unterordner, große Dateien, Shares, Docker-Image und VM-Abbilder
- Zuwachs über 24 Stunden und 7 Tage, Verlauf über 30 Tage
- Warnung wenn der Pool, die Btrfs-Metadaten oder die Prognose volllaufen
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
rm -f /usr/local/emhttp/plugins/cache-monitor/CacheMonitor.page \
  /usr/local/emhttp/plugins/cache-monitor/VERSION \
  /usr/local/emhttp/plugins/cache-monitor/include/common.php \
  /usr/local/emhttp/plugins/cache-monitor/include/view.php \
  /usr/local/emhttp/plugins/cache-monitor/include/page.php \
  /usr/local/emhttp/plugins/cache-monitor/scripts/collect.php \
  /usr/local/emhttp/plugins/cache-monitor/scripts/install.sh
mkdir -p /usr/local/emhttp/plugins/cache-monitor/include
mkdir -p /usr/local/emhttp/plugins/cache-monitor/scripts
mkdir -p /boot/config/plugins/cache-monitor
mkdir -p /var/local/cache-monitor
exit 0
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/&name;/VERSION" Mode="0644">
<URL>&gitURL;/VERSION</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/&name;/CacheMonitor.page" Mode="0644">
<URL>&gitURL;/CacheMonitor.page</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/&name;/include/common.php" Mode="0644">
<URL>&gitURL;/include/common.php</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/&name;/include/view.php" Mode="0644">
<URL>&gitURL;/include/view.php</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/&name;/include/page.php" Mode="0644">
<URL>&gitURL;/include/page.php</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/&name;/scripts/collect.php" Mode="0755">
<URL>&gitURL;/scripts/collect.php</URL>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
CFG=/boot/config/plugins/cache-monitor/cache-monitor.cfg
if [ ! -f "$CFG" ]; then
  printf '%s\n' \
    'WARN_PERCENT="80"' \
    'CRIT_PERCENT="90"' \
    'META_PERCENT="85"' \
    'FORECAST_DAYS="14"' \
    'SCAN_HOURS="6"' \
    'DEPTH="2"' \
    'NOTIFY="yes"' \
    'POOL=""' > "$CFG"
fi
printf '%s\n' '15 * * * * root /usr/bin/php -f /usr/local/emhttp/plugins/cache-monitor/scripts/collect.php >/dev/null 2>&1' > /etc/cron.d/cache-monitor
chmod 644 /etc/cron.d/cache-monitor 2>/dev/null
chmod 755 /usr/local/emhttp/plugins/cache-monitor/scripts/collect.php 2>/dev/null
if [ -f /var/run/crond.pid ]; then
  kill -HUP "$(cat /var/run/crond.pid)" 2>/dev/null
fi
echo "cache-monitor installiert"
exit 0
]]>
</INLINE>
</FILE>

</PLUGIN>
